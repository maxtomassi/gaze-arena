{
  "name": "gaze-arena",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run && npm run test --workspaces --if-present",
    "e2e": "npm run e2e --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.repo.json --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "new-game": "node scripts/new-game.mjs",
    "assets": "node -e \"console.error('tools/asset-gen is not implemented yet'); process.exit(1)\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
